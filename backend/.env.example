# Backend environment variables for PathForge

# Server Port
PORT=5000

# MongoDB Atlas connection string
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/pathforge?retryWrites=true&w=majority
MONGO_URI=your_mongodb_atlas_connection_string_here

# Optional: custom DNS servers for MongoDB SRV resolution
# If your machine cannot resolve Atlas SRV records, uncomment and set this.
# DNS_SERVERS=8.8.8.8,8.8.4.4

# JWT secret key for authentication
# Use a long random value in production and never commit it to git
JWT_SECRET=your_long_random_jwt_secret_here

# JWT expiration duration
JWT_EXPIRE=7d
